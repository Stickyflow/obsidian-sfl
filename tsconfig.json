{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    // "bundler" so `tsc` honours the `stickyflow` package's `exports` map and
    // can resolve the `stickyflow/viewer` subpath the same way esbuild does at
    // bundle time. Classic "node" resolution ignores `exports` and can't find it.
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES6", "ES7"]
  },
  "include": ["src/**/*.ts"]
}
